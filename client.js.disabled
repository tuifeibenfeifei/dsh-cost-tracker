// dsh-cost-tracker 前端半身
//
// 职责：在模型选择器旁注入 WorkBuddy 模型的免费状态 / 积分倍率 / 促销徽章。
//
// 用 ctx.slots.inject('conversation.input.model.label', ...) 注册。
// 该 slot 是 single 类型（只能有一家注册），实测 dsh-workbuddy-connect 未占用它，
// 所以可以安全占位。
//
// 数据来源：宿主路由 GET /cost-tracker/models（免费状态实时读 workbuddy status
// 接口，不硬编码免费时间表——免费期会变）。

const inject = ['slots', 'remote']

/** 拉取徽章表；失败返回空表，不影响主流程 */
async function fetchBadges() {
  try {
    const res = await fetch('/cost-tracker/models', { headers: { accept: 'application/json' } })
    if (!res.ok) return {}
    const j = await res.json()
    return (j && typeof j.badges === 'object' && j.badges) || {}
  } catch {
    return {}
  }
}

function apply(ctx) {
  const registry = ctx.slots
  if (!registry || typeof registry.inject !== 'function') return

  ctx.effect(() => {
    const dispose = registry.inject('conversation.input.model.label', () => {
      return registry.register({
        name: 'conversation.input.model.label',
        id: 'cost-tracker-model-badge',
      }, () => {
        // single slot 的内容渲染函数：读取当前模型并返回徽章文案
        const el = {
          type: 'span',
          props: {
            'data-cost-tracker-badge': '1',
            style: {
              marginInlineStart: '6px',
              fontSize: '11px',
              lineHeight: '16px',
              padding: '0 6px',
              borderRadius: '999px',
              background: 'var(--dsw-alias-bg-layer-2, rgba(127, 127, 127, 0.12))',
              color: 'var(--dsw-alias-label-secondary, inherit)',
              whiteSpace: 'nowrap',
            },
          },
          children: [],
        }
        return el
      })
    })
    return () => { try { dispose && dispose() } catch { /* 忽略 */ } }
  })
}

export { inject, apply }
